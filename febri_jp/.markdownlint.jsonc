{
  "default": true,

  // -----------------------------------------------------------------------
  // 設定で抑制するルール（元の記事のスタイルを踏襲する）
  // -----------------------------------------------------------------------

  // MD013: 行長制限
  // 日本語長文のため無効。改行はそのまま保持する運用。
  "MD013": false,

  // MD024: 見出しの重複
  // 1 つの記事に「作品情報」「関連情報」などの見出しが内容の異なる節として
  // 複数あるため無効。元の記事の見出しをそのまま保持する。
  "MD024": false,

  // MD025: 複数H1
  // front matter の title: と本文の # が両方H1として検知されるため、
  // front_matter_title: "" でfront matterをH1カウントから除外。
  "MD025": {
    "front_matter_title": ""
  },

  // MD026: 見出し末尾の句読点
  // 日本語見出し末尾の「！」はアーカイブとして保持するため無効。
  "MD026": false,

  // MD028: 引用ブロック内の空行
  // 独立した注釈を区切る意図的な空行のため無効。
  "MD028": false,

  // MD036: 強調を見出し代わりに使用
  // *取材・文／○○* や人物紹介の **名前** 等はアーカイブとして保持するため無効。
  "MD036": false,

  // MD042: 空のリンク
  // [公式サイト](#) はアーカイブ時にURLが取得できなかった記録として保持するため無効。
  "MD042": false,

  // MD045: 画像のalt textなし
  // アーカイブ用途のためalt textは不要。無効。
  "MD045": false

  // -----------------------------------------------------------------------
  // 既定のまま有効にしているルールの補足
  // -----------------------------------------------------------------------

  // 以下は scripts/structurize.py が出力時に対処しているため、抑制していない。
  // MD009: 行末のスペース       → 行末の空白（全角スペースを含む）を出力しない
  // MD018: # 後のスペースなし    → 行頭の # をエスケープする
  // MD032: リスト前後の空行      → ブロックの間に必ず空行を入れる
  // MD033: インラインHTML        → <br> を使わず段落・行末の \ で改行する
  // MD034: 本文中のURL           → <https://...> 形式で出力する
  // MD049: 強調スタイルの混在    → 本文中の _ をエスケープし、強調は * で統一する
}
